# Dependencies — covers root, server, eaze-react-app, and any future packages
node_modules/

# Build outputs — covers eaze-react-app/dist, eaze-react-app/release, etc.
dist/
dist-ssr/
release/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables (server/.env must never be committed)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local overrides
*.local
